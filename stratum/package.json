{
  "name": "noidmobile-stratum-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stratum V2 Noise bridge for the noidmobile miner. Translates between browser WebSocket (JSON, newline-delimited) and Stratum V2 Noise-over-TCP pool connections.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^1.5.0",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
